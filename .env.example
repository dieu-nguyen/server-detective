# ============================================================================
# Telegram Server Debug Agent — Environment Variables (.env)
# ============================================================================

# 1. Telegram Bot Token (Required — create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. MySQL Read-Only User Password (Required if mysql.enabled is true)
MYSQL_PASSWORD=your_readonly_mysql_password

# 3. CLI Subscription Mode Auth (Optional if already logged in interactively via `agent login` / `claude login`)
# If using Cursor CLI headlessly without interactive browser login, you can optionally set CURSOR_API_KEY
CURSOR_API_KEY=

# 4. SDK API Key Mode Credentials (Only needed when engine.mode is "sdk_apikey" or for fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
